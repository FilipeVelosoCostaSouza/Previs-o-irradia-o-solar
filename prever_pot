import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import MinMaxScaler
from sklearn.neural_network import MLPRegressor
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import (
    mean_squared_error,
    mean_absolute_error,
    r2_score
)

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense


# ==========================================================
# 1. LEITURA DOS DADOS
# ==========================================================

df = pd.read_csv("irradiancia_joao_pessoa_estimada.csv")

variaveis = df[
    [
        "Irradiancia Global",
        "Temperatura do Ar",
        "Umidade Relativa",
        "Velocidade do Vento"
    ]
].values

alvo = df["Irradiancia Global"].values


# ==========================================================
# 2. CRIAÇÃO DAS JANELAS DE 24 HORAS
# ==========================================================

janela = 24
X, y = [], []

for i in range(janela, len(df)):
    X.append(variaveis[i - janela:i])
    y.append(alvo[i])

X = np.array(X)
y = np.array(y).reshape(-1, 1)


# ==========================================================
# 3. DIVISÃO: 70% TREINO, 15% VALIDAÇÃO E 15% TESTE
# ==========================================================

n = len(X)

fim_treino = int(n * 0.70)
fim_validacao = int(n * 0.85)

X_treino = X[:fim_treino]
X_validacao = X[fim_treino:fim_validacao]
X_teste = X[fim_validacao:]

y_treino = y[:fim_treino]
y_validacao = y[fim_treino:fim_validacao]
y_teste = y[fim_validacao:]


# ==========================================================
# 4. NORMALIZAÇÃO
# ==========================================================

scaler_X = MinMaxScaler()
scaler_y = MinMaxScaler()

scaler_X.fit(X_treino.reshape(-1, 4))

X_treino_norm = scaler_X.transform(
    X_treino.reshape(-1, 4)
).reshape(X_treino.shape)

X_validacao_norm = scaler_X.transform(
    X_validacao.reshape(-1, 4)
).reshape(X_validacao.shape)

X_teste_norm = scaler_X.transform(
    X_teste.reshape(-1, 4)
).reshape(X_teste.shape)

y_treino_norm = scaler_y.fit_transform(y_treino)
y_validacao_norm = scaler_y.transform(y_validacao)


# MLP e Random Forest usam dados bidimensionais
X_treino_2d = X_treino_norm.reshape(len(X_treino_norm), -1)
X_validacao_2d = X_validacao_norm.reshape(len(X_validacao_norm), -1)
X_teste_2d = X_teste_norm.reshape(len(X_teste_norm), -1)


# ==========================================================
# 5. MODELO MLP
# ==========================================================

mlp = MLPRegressor(
    hidden_layer_sizes=(100, 50, 25),
    activation="relu",
    solver="adam",
    batch_size=32,
    learning_rate_init=0.001,
    max_iter=500,
    random_state=42
)

mlp.fit(
    X_treino_2d,
    y_treino_norm.ravel()
)

previsao_val_mlp_norm = mlp.predict(
    X_validacao_2d
).reshape(-1, 1)

previsao_teste_mlp_norm = mlp.predict(
    X_teste_2d
).reshape(-1, 1)

previsao_mlp = scaler_y.inverse_transform(
    previsao_teste_mlp_norm
)


# ==========================================================
# 6. MODELO LSTM
# ==========================================================

lstm = Sequential([
    LSTM(
        100,
        activation="relu",
        input_shape=(janela, 4)
    ),
    Dense(1)
])

lstm.compile(
    loss="mean_squared_error",
    optimizer="adam"
)

lstm.fit(
    X_treino_norm,
    y_treino_norm,
    validation_data=(
        X_validacao_norm,
        y_validacao_norm
    ),
    epochs=50,
    batch_size=32,
    verbose=2,
    shuffle=False
)

previsao_val_lstm_norm = lstm.predict(
    X_validacao_norm
)

previsao_teste_lstm_norm = lstm.predict(
    X_teste_norm
)

previsao_lstm = scaler_y.inverse_transform(
    previsao_teste_lstm_norm
)


# ==========================================================
# 7. MODELO RANDOM FOREST
# ==========================================================

rf = RandomForestRegressor(
    n_estimators=300,
    random_state=42,
    n_jobs=-1
)

rf.fit(
    X_treino_2d,
    y_treino.ravel()
)

previsao_rf = rf.predict(
    X_teste_2d
).reshape(-1, 1)


# ==========================================================
# 8. MODELO HÍBRIDO LSTM + MLP
# ==========================================================

melhor_rmse = float("inf")
melhor_peso_lstm = 0

for w in np.arange(0, 1.05, 0.05):

    previsao_val_hibrida_norm = (
        w * previsao_val_lstm_norm
        + (1 - w) * previsao_val_mlp_norm
    )

    previsao_val_hibrida = scaler_y.inverse_transform(
        previsao_val_hibrida_norm
    )

    rmse_validacao = np.sqrt(
        mean_squared_error(
            y_validacao,
            previsao_val_hibrida
        )
    )

    if rmse_validacao < melhor_rmse:
        melhor_rmse = rmse_validacao
        melhor_peso_lstm = w


melhor_peso_mlp = 1 - melhor_peso_lstm

previsao_hibrida_norm = (
    melhor_peso_lstm * previsao_teste_lstm_norm
    + melhor_peso_mlp * previsao_teste_mlp_norm
)

previsao_hibrida = scaler_y.inverse_transform(
    previsao_hibrida_norm
)

print("\nMELHOR COMBINAÇÃO HÍBRIDA")
print(f"LSTM: {melhor_peso_lstm * 100:.0f}%")
print(f"MLP: {melhor_peso_mlp * 100:.0f}%")
print(f"RMSE na validação: {melhor_rmse:.4f}")


# ==========================================================
# 9. MÉTRICAS
# ==========================================================

def calcular_metricas(real, previsto):
    mse = mean_squared_error(real, previsto)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(real, previsto)
    r2 = r2_score(real, previsto)

    return mse, rmse, mae, r2


mse_mlp, rmse_mlp, mae_mlp, r2_mlp = calcular_metricas(
    y_teste,
    previsao_mlp
)

mse_lstm, rmse_lstm, mae_lstm, r2_lstm = calcular_metricas(
    y_teste,
    previsao_lstm
)

mse_rf, rmse_rf, mae_rf, r2_rf = calcular_metricas(
    y_teste,
    previsao_rf
)

mse_hibrido, rmse_hibrido, mae_hibrido, r2_hibrido = calcular_metricas(
    y_teste,
    previsao_hibrida
)


# ==========================================================
# 10. RESULTADOS
# ==========================================================

resultados = pd.DataFrame({
    "Modelo": [
        "MLP",
        "LSTM",
        "Random Forest",
        "Híbrido LSTM + MLP"
    ],
    "MSE": [
        mse_mlp,
        mse_lstm,
        mse_rf,
        mse_hibrido
    ],
    "RMSE": [
        rmse_mlp,
        rmse_lstm,
        rmse_rf,
        rmse_hibrido
    ],
    "MAE": [
        mae_mlp,
        mae_lstm,
        mae_rf,
        mae_hibrido
    ],
    "R²": [
        r2_mlp,
        r2_lstm,
        r2_rf,
        r2_hibrido
    ]
})

print("\nCOMPARAÇÃO DOS MODELOS")
print(resultados)


# ==========================================================
# 11. GRÁFICOS DE DISPERSÃO
# ==========================================================

limite_min = min(
    y_teste.min(),
    previsao_mlp.min(),
    previsao_lstm.min(),
    previsao_rf.min(),
    previsao_hibrida.min()
)

limite_max = max(
    y_teste.max(),
    previsao_mlp.max(),
    previsao_lstm.max(),
    previsao_rf.max(),
    previsao_hibrida.max()
)

plt.figure(figsize=(14, 11))


plt.subplot(2, 2, 1)

plt.scatter(
    y_teste,
    previsao_mlp,
    alpha=0.4
)

plt.plot(
    [limite_min, limite_max],
    [limite_min, limite_max],
    "r--"
)

plt.xlabel("Irradiância real")
plt.ylabel("Irradiância prevista")
plt.title(f"MLP — R² = {r2_mlp:.3f}")
plt.grid()


plt.subplot(2, 2, 2)

plt.scatter(
    y_teste,
    previsao_lstm,
    alpha=0.4
)

plt.plot(
    [limite_min, limite_max],
    [limite_min, limite_max],
    "r--"
)

plt.xlabel("Irradiância real")
plt.ylabel("Irradiância prevista")
plt.title(f"LSTM — R² = {r2_lstm:.3f}")
plt.grid()


plt.subplot(2, 2, 3)

plt.scatter(
    y_teste,
    previsao_rf,
    alpha=0.4
)

plt.plot(
    [limite_min, limite_max],
    [limite_min, limite_max],
    "r--"
)

plt.xlabel("Irradiância real")
plt.ylabel("Irradiância prevista")
plt.title(f"Random Forest — R² = {r2_rf:.3f}")
plt.grid()


plt.subplot(2, 2, 4)

plt.scatter(
    y_teste,
    previsao_hibrida,
    alpha=0.4
)

plt.plot(
    [limite_min, limite_max],
    [limite_min, limite_max],
    "r--"
)

plt.xlabel("Irradiância real")
plt.ylabel("Irradiância prevista")

plt.title(
    f"Híbrido — {melhor_peso_lstm * 100:.0f}% LSTM + "
    f"{melhor_peso_mlp * 100:.0f}% MLP\n"
    f"R² = {r2_hibrido:.3f}"
)

plt.grid()

plt.tight_layout()
plt.show()
