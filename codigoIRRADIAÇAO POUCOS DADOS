# MODELOS
# =========================

def prever_rf(Xtr, ytr, X):
    modelo = RandomForestRegressor(
        n_estimators=300,
        random_state=42,
        n_jobs=-1
    )

    modelo.fit(Xtr, ytr)
    pred = modelo.predict(X)

    return pred


def prever_mlp_calibrado(Xtr, ytr, X, clip_zero=True):
    sx = StandardScaler()
    Xtr_s = sx.fit_transform(Xtr)
    X_s = sx.transform(X)

    sy = MinMaxScaler()
    ytr_s = sy.fit_transform(ytr.values.reshape(-1, 1)).ravel()

    mlp = MLPRegressor(
        hidden_layer_sizes=(8,),
        activation="relu",
        solver="adam",
        alpha=0.01,
        batch_size=4,
        learning_rate_init=0.001,
        max_iter=3000,
        early_stopping=True,
        validation_fraction=0.2,
        n_iter_no_change=20,
        random_state=42
    )

    mlp.fit(Xtr_s, ytr_s)

    pred_s = mlp.predict(X_s)

    pred = sy.inverse_transform(
        pred_s.reshape(-1, 1)
    ).ravel()

    if clip_zero:
        pred = np.clip(pred, 0, None)

    return pred


def prever_lstm(Xtr, ytr, Xpred, janela, epochs=50):
    tf.random.set_seed(42)
    np.random.seed(42)

    sx = MinMaxScaler()
    sy = MinMaxScaler()

    Xtr_s = pd.DataFrame(
        sx.fit_transform(Xtr),
        index=Xtr.index,
        columns=Xtr.columns
    )

    ytr_s = pd.Series(
        sy.fit_transform(ytr.values.reshape(-1, 1)).ravel(),
        index=ytr.index
    )

    Xtr_seq, ytr_seq = criar_janelas(Xtr_s, ytr_s, janela)

    if len(Xtr_seq) == 0:
        raise ValueError("Treino insuficiente para criar janelas da LSTM.")

    model = tf.keras.Sequential([
        tf.keras.layers.Input(shape=(janela, Xtr_seq.shape[2])),
        tf.keras.layers.LSTM(64, activation="tanh", return_sequences=True),
        tf.keras.layers.Dropout(0.2),
        tf.keras.layers.LSTM(64, activation="tanh", return_sequences=False),
        tf.keras.layers.Dense(1)
    ])

    model.compile(
        optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
        loss="mse"
    )

    es = tf.keras.callbacks.EarlyStopping(
        monitor="val_loss",
        patience=8,
        restore_best_weights=True
    )

    model.fit(
        Xtr_seq,
        ytr_seq,
        epochs=epochs,
        batch_size=32,
        verbose=0,
        validation_split=0.1,
        callbacks=[es]
    )

    # Junta o fim do treino com o período de previsão.
    # Isso permite gerar a primeira janela do teste usando o contexto final do treino.
    X_contexto = pd.concat([
        Xtr.iloc[-janela:],
        Xpred
    ])

    X_contexto_s = pd.DataFrame(
        sx.transform(X_contexto),
        index=X_contexto.index,
        columns=X_contexto.columns
    )

    Xseq_pred, _ = criar_janelas(
        X_contexto_s,
        pd.Series(np.zeros(len(X_contexto_s)), index=X_contexto_s.index),
        janela
    )

    pred_s = model.predict(Xseq_pred, verbose=0).ravel()
    pred = sy.inverse_transform(pred_s.reshape(-1, 1)).ravel()
    pred = np.clip(pred, 0, None)

    return pd.Series(pred, index=Xpred.index)


def encontrar_melhor_peso_hibrido(y_real, pred_lstm, pred_mlp):
    """
    Procura o melhor peso da LSTM no híbrido:

        pred_hibrido = w * LSTM + (1 - w) * MLP

    A busca é feita pelo menor RMSE na validação.
    """

    idx = y_real.index.intersection(pred_lstm.index).intersection(pred_mlp.index)

    if len(idx) == 0:
        raise ValueError("Não há índice comum entre y_real, LSTM e MLP na validação.")

    y = y_real.loc[idx]
    lstm = pred_lstm.loc[idx]
    mlp = pred_mlp.loc[idx]

    best_rmse = np.inf
    best_w = None
    best_mae = None
    best_r2 = None

    for w in np.linspace(0, 1, 21):
        pred_h = w * lstm + (1 - w) * mlp

        rmse, mae, r2 = metricas(y, pred_h)

        if rmse < best_rmse:
            best_rmse = rmse
            best_mae = mae
            best_r2 = r2
            best_w = w

    return best_w, best_rmse, best_mae, best_r2


