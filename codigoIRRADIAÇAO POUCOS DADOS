# =========================
# FUNÇÕES DE MÉTRICAS
# =========================

def metricas(y_true, y_pred):
    mse = mean_squared_error(y_true, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y_true, y_pred)
    r2 = r2_score(y_true, y_pred)
    return rmse, mae, r2


def imprimir(nome, y_true, y_pred):
    rmse, mae, r2 = metricas(y_true, y_pred)
    print(f"{nome:22s} | RMSE={rmse:8.2f} | MAE={mae:7.2f} | R²={r2:7.3f}")


def avaliar_serie(nome, y_real, pred):
    """
    Avalia uma previsão usando apenas o índice temporal comum
    entre y_real e pred.
    """

    if not isinstance(pred, pd.Series):
        raise TypeError("pred precisa ser uma pd.Series com índice temporal.")

    idx = y_real.index.intersection(pred.index)

    if len(idx) == 0:
        print(f"{nome:22s} | Sem índice comum para avaliação.")
        return None

    imprimir(nome, y_real.loc[idx], pred.loc[idx])

    return idx


# =========================
# FUNÇÕES AUXILIARES
# =========================

def split_temporal(df, frac):
    corte = int(len(df) * frac)
    return df.iloc[:corte], df.iloc[corte:]


def aplicar_zero_noite(pred, horas):
    pred = np.array(pred).copy()

    # Zera noite e horários de transição mais problemáticos
    mask_noite = (horas <= 6) | (horas >= 18)
    pred[mask_noite] = 0

    # Remove valores negativos
    pred = np.clip(pred, 0, None)

    return pred


def criar_janelas(X_df, y_ser, janela):
    Xv = X_df.values
    yv = y_ser.values

    Xseq, yseq = [], []

    for i in range(janela, len(Xv)):
        Xseq.append(Xv[i - janela:i])
        yseq.append(yv[i])

    return np.array(Xseq), np.array(yseq)


def adicionar_lags_rad(base, lags=(1, 2, 3)):
    base_lag = base.copy()

    for lag in lags:
        base_lag[f"rad_lag{lag}"] = base_lag["rad"].shift(lag)

    return base_lag.dropna()


def heatmap_corr(base):
    corr = base[["rad", "temp", "umid", "vento"]].dropna().corr(numeric_only=True)

    plt.figure(figsize=(6, 5))
    im = plt.imshow(corr.values, vmin=-1, vmax=1, cmap="coolwarm")
    plt.colorbar(im)

    plt.xticks(range(len(corr.columns)), corr.columns, rotation=45, ha="right")
    plt.yticks(range(len(corr.index)), corr.index)
    plt.title("Correlação (rad, temp, umid, vento)")

    for i in range(corr.shape[0]):
        for j in range(corr.shape[1]):
            v = corr.iloc[i, j]
            plt.text(
                j,
                i,
                f"{v:.2f}",
                ha="center",
                va="center",
                color="white" if abs(v) > 0.5 else "black"
            )

    plt.tight_layout()


